{
  "name": "merchant-countertop-scanner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port=3000",
    "typecheck": "tsc --noEmit",
    "seed:dev": "node --env-file=.env.local scripts/seed-dev.mjs",
    "token:dev": "node --env-file=.env.local scripts/customer-token.mjs",
    "check:backend": "node --env-file=.env.local scripts/check-backend.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
